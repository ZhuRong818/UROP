{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portend.local/schema/raw-batch-manifest-1.0.0.json",
  "title": "PORTEND immutable raw-batch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "raw_batch_id",
    "source_run_id",
    "source",
    "stream",
    "relative_path",
    "compression",
    "content_sha256",
    "byte_count",
    "record_count",
    "min_event_ts",
    "max_event_ts",
    "min_received_ts",
    "max_received_ts",
    "ingested_at",
    "schema_version",
    "collector_code_commit",
    "collector_config_hash"
  ],
  "properties": {
    "raw_batch_id": {"type": "string", "minLength": 1},
    "source_run_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "stream": {"type": "string", "minLength": 1},
    "relative_path": {"type": "string", "minLength": 1},
    "compression": {"enum": ["zstd", "gzip", "none"]},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "byte_count": {"type": "integer", "minimum": 1},
    "record_count": {"type": "integer", "minimum": 0},
    "min_event_ts": {"type": ["string", "null"], "format": "date-time"},
    "max_event_ts": {"type": ["string", "null"], "format": "date-time"},
    "min_received_ts": {"type": ["string", "null"], "format": "date-time"},
    "max_received_ts": {"type": ["string", "null"], "format": "date-time"},
    "ingested_at": {"type": "string", "format": "date-time"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "collector_code_commit": {"type": "string", "minLength": 7},
    "collector_config_hash": {"type": "string", "minLength": 16},
    "request_or_connection_id": {"type": ["string", "null"]}
  }
}
